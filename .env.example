# ------------------------------------------------------------------
# Servey website — environment variables
# Copy to `.env.local` and fill in the provider you want. Never commit secrets.
# ------------------------------------------------------------------

# Which waitlist backend to use. Optional — auto-detected from the vars below.
# One of: firebase | formspree | resend | console
# `console` (the default when nothing is configured) just logs signups and
# succeeds, so the form works out of the box in development.
# WAITLIST_PROVIDER=firebase

# --- Option A: Firebase (recommended — Servey already uses Firebase) ---------
# Service-account credentials for the Firebase Admin SDK. Signups are written to
# a `waitlist` collection, de-duped by normalized email (doc id = the email).
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project-id.iam.gserviceaccount.com
# Paste the private key with literal \n escapes, wrapped in double quotes:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# --- Option B: Formspree (zero-backend fallback) -----------------------------
# Create a form at https://formspree.io and paste its endpoint URL.
# FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# --- Option C: Resend Audiences (zero-backend fallback) ----------------------
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ------------------------------------------------------------------
# Transactional email (Resend)
# ------------------------------------------------------------------
# Sends the waitlist confirmation. Shares RESEND_API_KEY with the audience
# provider above - one key does both. Leave it unset and no mail is sent at all,
# which is what you want locally: signups still succeed, silently.
#
# The sending domain must be verified in Resend (DNS records at your registrar)
# before anything will deliver.
# RESEND_API_KEY=re_xxxxxxxx

# Overrides the From address. Must be on a domain verified in Resend. Defaults
# to "Servey <hello@servey.in>" from lib/site.ts.
# EMAIL_FROM=Servey <hello@servey.in>

# ------------------------------------------------------------------
# Analytics (PostHog)
# ------------------------------------------------------------------
# The project API key from PostHog -> Settings -> Project. It is a *public*
# write-only key and is meant to ship in the browser bundle, so NEXT_PUBLIC_ is
# correct here. Leave it unset and analytics is a silent no-op, which is what
# you want locally so dev traffic never pollutes production numbers.
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Only needed if the PostHog project is in the EU region. These are read in
# next.config.ts to build the /ingest reverse proxy, so a change requires a
# rebuild, not just a restart.
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_ASSET_HOST=https://eu-assets.i.posthog.com
# NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com

# Session replay is OFF unless this is exactly "true". Turning it on records
# real browsing, so update app/privacy/page.tsx before you enable it.
# NEXT_PUBLIC_POSTHOG_SESSION_RECORDING=true
